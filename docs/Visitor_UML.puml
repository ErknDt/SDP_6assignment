@startuml
title File System Visitor Pattern - Assignment 6
skinparam classAttributeIconSize 0
skinparam shadowing false

interface FileSystemElement {
  +getName(): String
  +accept(visitor: FileSystemVisitor): void
}
class FileElement {
  -name: String
  -sizeInBytes: long
  +getName(): String
  +getSizeInBytes(): long
  +accept(visitor: FileSystemVisitor): void
}
class DirectoryElement {
  -name: String
  -children: List<FileSystemElement>
  +getChildren(): List<FileSystemElement>
  +accept(visitor: FileSystemVisitor): void
}
interface FileSystemVisitor {
  +visitFile(file: FileElement): void
  +visitDirectory(directory: DirectoryElement): void
}
class SizeCalculatorVisitor {
  -totalSizeInBytes: long
  +getTotalSizeInBytes(): long
}
class SearchVisitor {
  -normalizedQuery: String
  -matches: List<FileElement>
  +getMatches(): List<FileElement>
}
class FileCountVisitor {
  -fileCount: int
  -directoryCount: int
  +getFileCount(): int
  +getDirectoryCount(): int
}

FileSystemElement <|.. FileElement
FileSystemElement <|.. DirectoryElement
DirectoryElement "1" o-- "0..*" FileSystemElement : children
FileSystemVisitor <|.. SizeCalculatorVisitor
FileSystemVisitor <|.. SearchVisitor
FileSystemVisitor <|.. FileCountVisitor
FileElement ..> FileSystemVisitor : visitFile(this)
DirectoryElement ..> FileSystemVisitor : visitDirectory(this)
@enduml
