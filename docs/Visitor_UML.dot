
digraph UML {
  graph [rankdir=TB, nodesep=0.38, ranksep=0.62, bgcolor=white, splines=polyline, pad=0.16, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [color="#687A93", penwidth=1.5, arrowsize=0.8, fontname="DejaVu Sans", fontsize=10];
  elements [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#E9F2FB" COLOR="#44719F">
      <TR><TD><FONT POINT-SIZE="10" COLOR="#44637F">&lt;&lt;interface&gt;&gt;</FONT><BR/><B>FileSystemElement</B></TD></TR>
      <HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ getName(): String<BR ALIGN="LEFT"/>+ accept(visitor): void</FONT></TD></TR>
    </TABLE>>];
  visitor [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#E9F2FB" COLOR="#44719F">
      <TR><TD><FONT POINT-SIZE="10" COLOR="#44637F">&lt;&lt;interface&gt;&gt;</FONT><BR/><B>FileSystemVisitor</B></TD></TR>
      <HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ visitFile(FileElement): void<BR ALIGN="LEFT"/>+ visitDirectory(DirectoryElement): void</FONT></TD></TR>
    </TABLE>>];
  file [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#F5F8FC" COLOR="#7287A3">
      <TR><TD><B>FileElement</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- name: String<BR ALIGN="LEFT"/>- sizeInBytes: long</FONT></TD></TR><HR/>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ accept(visitor): void<BR ALIGN="LEFT"/>+ getSizeInBytes(): long</FONT></TD></TR>
    </TABLE>>];
  dir [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#F5F8FC" COLOR="#7287A3">
      <TR><TD><B>DirectoryElement</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- name: String<BR ALIGN="LEFT"/>- children: List&lt;FileSystemElement&gt;</FONT></TD></TR><HR/>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ accept(visitor): void<BR ALIGN="LEFT"/>+ getChildren(): List</FONT></TD></TR>
    </TABLE>>];
  size [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#EDF7F4" COLOR="#4C9886">
      <TR><TD><B>SizeCalculatorVisitor</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ visitFile(file): void<BR ALIGN="LEFT"/>+ visitDirectory(dir): void</FONT></TD></TR>
    </TABLE>>];
  search [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#EDF7F4" COLOR="#4C9886">
      <TR><TD><B>SearchVisitor</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ visitFile(file): void<BR ALIGN="LEFT"/>+ visitDirectory(dir): void</FONT></TD></TR>
    </TABLE>>];
  count [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#EDF7F4" COLOR="#4C9886">
      <TR><TD><B>FileCountVisitor</B></TD></TR><HR/>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ visitFile(file): void<BR ALIGN="LEFT"/>+ visitDirectory(dir): void</FONT></TD></TR>
    </TABLE>>];
  {rank=same; elements; visitor}
  {rank=same; file; dir}
  {rank=same; size; search; count}
  file -> size [style=invis, weight=0.2]
  file -> elements [arrowhead=empty];
  dir -> elements [arrowhead=empty];
  size -> visitor [arrowhead=empty,style=dashed];
  search -> visitor [arrowhead=empty,style=dashed];
  count -> visitor [arrowhead=empty,style=dashed];
  file -> visitor [style=dotted, arrowhead=vee, constraint=false];
  dir -> visitor [style=dotted, arrowhead=vee, constraint=false];
}
